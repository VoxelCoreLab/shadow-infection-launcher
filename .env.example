# Firebase (same project as the Shadow Infection website)
# Copy this file to .env and fill in values from Firebase Console
# Project Settings → Your apps → Web app config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Defaults to https://shadowinfection.com
VITE_WEBSITE_URL=https://shadowinfection.com

# Optional API base URLs (without /api-json). Used by generated OpenAPI clients.
VITE_PATCH_NOTES_API_URL=https://patch-notes.shadowinfection.com
VITE_SHOP_API_URL=https://shop-api.shadowinfection.com
