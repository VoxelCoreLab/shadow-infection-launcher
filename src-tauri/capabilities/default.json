{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "allow-store-refresh-token",
    "allow-get-refresh-token",
    "allow-clear-refresh-token",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-default-install-path",
    "allow-open-install-folder",
    "allow-get-install-status",
    "allow-start-install",
    "allow-uninstall-game"
  ]
}
